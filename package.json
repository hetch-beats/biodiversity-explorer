{
  "name": "biodiversity-explorer",
  "version": "0.1.0",
  "description": "Interactive 3D globe for exploring animal species and their global distribution.",
  "main": "./out/main/index.js",
  "author": "Harshel Khivsare",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/fetch-earth-texture.mjs && electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "fetch-redlist": "node scripts/fetch-redlist-data.mjs",
    "fetch-textures": "node scripts/fetch-globe-textures.mjs",
    "generate-icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.3.0",
    "extract-zip": "^2.0.1",
    "fuse.js": "^7.0.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "three": "^0.170.0",
    "three-globe": "^2.45.2",
    "three-slippy-map-globe": "^1.0.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.biodiversityexplorer.app",
    "productName": "Biodiversity Explorer",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
